YOLO_MODEL_PATH=models/best.pt
ANOMALY_MODEL_PATH=models/efficientad.onnx
IMAGE_SOURCE=data/testdata
OUTPUT_DIR=runs/inference
DEVICE=0
IMAGE_SIZE=2048
CONF_THRESHOLD=0.35
OUTPUT_CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.50
USE_TENSORRT=false
TENSORRT_ENGINE_PATH=models/best.engine
USE_ANOMALY_CHECK=false
ANOMALY_SCORE_THRESHOLD=0.60
ENABLE_SAVE_VISUALIZATION=true
ENABLE_SAVE_JSON=true
ENABLE_SAVE_YOLO_TXT=true
ENABLE_SAVE_YOLO_CONF=true
VISUALIZATION_LINE_WIDTH=5
VISUALIZATION_FONT_SCALE=2.0
VISUALIZATION_FONT_THICKNESS=4
OVERLAP_IOU_THRESHOLD=0.30
ENABLE_REVIEW_SAVE=false
REVIEW_DIR=data/review
REVIEW_SAVE_NG=true
REVIEW_SAVE_LOW_CONF=true
REVIEW_LOW_CONF_THRESHOLD=0.45
REVIEW_SAVE_ANOMALY=true
OK_CLASSES=oreo_ok
DEFECT_CLASSES=edge_damage,broken,fragment,overlap,no_cookie
SLOT_CLASSES=no_cookie
HIDE_CLASSES_IN_OUTPUT=oreo_ok
CLASS_DISPLAY_NAMES=oreo_ok:完整饼干,edge_damage:缺角,broken:破裂,fragment:零碎饼干,overlap:重叠,no_cookie:无饼干
EXPECTED_COOKIE_MIN_COUNT=1
EXPECTED_COOKIE_MAX_COUNT=2
MIN_COOKIE_BOX_AREA=1000
MIN_DEFECT_BOX_AREA=10
